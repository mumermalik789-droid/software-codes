  pkg = u_data.get("package", "basic")
  count = u_data.get("prompt_count", 0)

  # Check daily prompt limits
  if not is_user_admin:
    if pkg == "basic" and count >= 15:
      wa_msg = f"AoA {ADMIN_NAME}, mera basic package limit (15) poori ho chuki hai. Mujhe package upgrade karwana hai."
      st.error("🚫 **Daily Prompt Limit Reached!** Aapke Basic package ki 15 prompts ki limit mukammal ho chuki hai.")
      render_payment_and_contact_card(wa_msg)
      st.stop()
    elif pkg == "standard" and count >= 25:
      wa_msg = f"AoA {ADMIN_NAME}, mera standard package limit (25) poori ho chuki hai. Mujhe Premium package upgrade karwana hai."
      st.error("🚫 **Daily Prompt Limit Reached!** Aapke Standard package ki 25 prompts ki limit mukammal ho chuki hai.")
      render_payment_and_contact_card(wa_msg)
      st.stop()

  messages = []
  if image_file is not None:
    base64_image = encode_image(image_file)
    messages.append({
        "role": "user",
        "content": [
            {
                "type": "image",
                "source": {
                    "type": "base64",
                    "media_type": "image/jpeg",
                    "data": base64_image,
                },
            },
            {"type": "text", "text": prompt_text},
        ],
    })
  else:
    messages.append({"role": "user", "content": prompt_text})

  try:
    res = client.messages.create(
        model="claude-sonnet-4-6",
        max_tokens=3500,
        system=SYSTEM_LEGAL_PROMPT,
        messages=messages,
    )
    
    # Increment count ONLY AFTER successful response generation
    u_data["prompt_count"] = count + 1
    save_users(users_db)
    
    return res.content[0].text

  except Exception as e:
    st.error(f"AI Response Generation Error: {e}")
    st.stop()

