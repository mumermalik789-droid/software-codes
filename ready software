# SESSIONS (login refresh par bhi rahe, lekin sirf random token se)
# =====================================================================
def _h(token):
    return hashlib.sha256(token.encode()).hexdigest()

def new_session(uid):
    u = users_db[uid]
    sessions = u.setdefault("sessions", {})
    now = time.time()
    for h, ts in list(sessions.items()):
        if now - ts > SESSION_DAYS * 86400:
            del sessions[h]
    if not u.get("is_admin"):
        limit = MAX_DEVICES.get(u.get("package"), 2)
        while len(sessions) >= limit:          # sab se purani device logout
            del sessions[min(sessions, key=sessions.get)]
    token = secrets.token_urlsafe(24)
    sessions[_h(token)] = now
    save_users()
    return token

def user_from_token(token):
    h = _h(token)
    for uid, u in users_db.items():
        ts = u.get("sessions", {}).get(h)
        if ts and time.time() - ts <= SESSION_DAYS * 86400:
            return uid
    return None

def end_session(uid, token):
    if uid in users_db and token:
        users_db[uid].get("sessions", {}).pop(_h(token), None)
        save_users()


