def send_email(to, subject, body):
    if not (SMTP_USER and SMTP_PASS):
        return False, "Email service configure nahi hai (SMTP_EMAIL / SMTP_PASSWORD secrets missing)."
    msg = EmailMessage()
    msg["From"], msg["To"], msg["Subject"] = SMTP_USER, to, subject
    msg.set_content(body)
    try:
        ctx = ssl.create_default_context()
        if SMTP_PORT == 465:
            with smtplib.SMTP_SSL(SMTP_HOST, SMTP_PORT, context=ctx, timeout=20) as s:
                s.login(SMTP_USER, SMTP_PASS)
                s.send_message(msg)
        else:
            with smtplib.SMTP(SMTP_HOST, SMTP_PORT, timeout=20) as s:
                s.starttls(context=ctx)
                s.login(SMTP_USER, SMTP_PASS)
                s.send_message(msg)
        return True, ""
    except Exception as e:
        return False, f"Email send nahi ho saka: {e}"

def otp_send(purpose, email, payload=None):
    key = f"{purpose}:{canonical_email(email)}"
    pend = read_json(PENDING_FILE, {})
    now = time.time()
    pend = {k: v for k, v in pend.items() if v.get("expires", 0) > now}
    old = pend.get(key)
    if old and now - old["sent_at"] < RESEND_SECONDS:
        return False, f"{int(RESEND_SECONDS - (now - old['sent_at']))} second baad dobara try karein."
    code = f"{secrets.randbelow(10**6):06d}"
    body = (f"Aapka Pakistani Legal AI Portal verification code: {code}\n\n"
            f"Ye code {OTP_VALID_SECONDS // 60} minute tak valid hai. "
            "Agar ye aap ne request nahi kiya to is email ko ignore karein.")
    ok, err = send_email(email, "Your verification code - Legal AI Portal", body)
    if not ok:
        if DEV_SHOW_OTP and not (SMTP_USER and SMTP_PASS):
            pend[key] = {"code": _h(code), "expires": now + OTP_VALID_SECONDS,
                         "attempts": 0, "sent_at": now, "payload": payload or {}}
            write_json(PENDING_FILE, pend)
            return True, f"TEST MODE - code: {code}"
        return False, err
    pend[key] = {"code": _h(code), "expires": now + OTP_VALID_SECONDS,
                 "attempts": 0, "sent_at": now, "payload": payload or {}}
    write_json(PENDING_FILE, pend)
    return True, ""

def otp_check(purpose, email, code):
    key = f"{purpose}:{canonical_email(email)}"
    pend = read_json(PENDING_FILE, {})
    rec = pend.get(key)
    if not rec or rec["expires"] < time.time():
        return False, "Code expire ho gaya. Naya code mangwayein.", {}
    if rec["attempts"] >= 5:
        return False, "Bohat ghalat koshishein. Naya code mangwayein.", {}
    if not hmac.compare_digest(rec["code"], _h(code.strip())):
        rec["attempts"] += 1
        write_json(PENDING_FILE, pend)
        return False, "Code ghalat hai.", {}
    payload = rec["payload"]
    del pend[key]
    write_json(PENDING_FILE, pend)
    return True, "", payload


