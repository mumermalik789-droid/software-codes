    if u.get("is_admin"):
        return bool(ADMIN_PASSWORD) and hmac.compare_digest(pw, ADMIN_PASSWORD)
    if not check_password(pw, u.get("password", "")):
        return False
    if "$" not in u["password"]:          # purana hash -> naya strong hash
        u["password"] = hash_password(pw)
        save_users()
    return True


