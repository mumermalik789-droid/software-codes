def read_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default

def write_json(path, data):
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
    except Exception:
        pass

def wa_link(msg="", phone=ADMIN_PHONE):
    return f"https://wa.me/{phone}?text={urllib.parse.quote(msg)}"

def norm_phone(p):
    d = re.sub(r"\D", "", p or "")
    if d.startswith("0"):
        d = "92" + d[1:]
    return d

def parse_date(s):
    try:
        return datetime.strptime(str(s), "%Y-%m-%d").date()
    except Exception:
        return None

def safe_key(uid):
    return uid if "@" not in uid else re.sub(r"[^a-z0-9]+", "_", uid.lower())

EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")

def canonical_email(email):
    """Gmail ke dots aur +tags ignore karta hai taa-ke ek hi inbox se
    a.b@gmail.com / ab+1@gmail.com wagera se dusre account na banein."""
    e = email.strip().lower()
    local, _, domain = e.partition("@")
    if domain in ("gmail.com", "googlemail.com"):
        local = local.split("+")[0].replace(".", "")
        domain = "gmail.com"
    return f"{local}@{domain}"


