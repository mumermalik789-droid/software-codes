def find_account(identifier):
    ident = identifier.strip()
    if not ident:
        return None
    if ident in users_db:
        return ident
    low = ident.lower()
    for uid, u in users_db.items():
        if uid.lower() == low or u.get("email", "").lower() == low:
            return uid
    canon = canonical_email(ident) if EMAIL_RE.match(ident) else None
    if canon:
        for uid, u in users_db.items():
            if u.get("email_canon") == canon:
                return uid
    return None

def email_in_use(email, except_uid=None):
    canon = canonical_email(email)
    return any(u.get("email_canon") == canon and uid != except_uid
               for uid, u in users_db.items())

