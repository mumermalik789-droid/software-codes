        st.error(f"AI se jawab nahi aa saka: {e}")
        st.stop()
    user["prompt_count"] = user.get("prompt_count", 0) + 1
    save_users()
    return res.content[0].text

def make_docx(text, urdu=False):
    d = docx.Document()
    for line in text.split("\n"):
        line = line.strip()
        if not line:
            continue
        p = d.add_paragraph()
        if urdu:
            p._p.get_or_add_pPr().insert(0, OxmlElement("w:bidi"))
        for part in re.split(r"(\*\*.*?\*\*)", line):
            if not part:
                continue
            run = p.add_run()
            if part.startswith("**") and part.endswith("**"):
                run.text, run.bold = part[2:-2], True
            else:
                run.text = part.replace("###", "").replace("##", "").replace("#", "")
            if urdu:
                run.font.name = "Jameel Noori Nastaliq"
                run.font.size = docx.shared.Pt(14)
                rpr = run._r.get_or_add_rPr()
                rpr.find(qn("w:rFonts")).set(qn("w:cs"), "Jameel Noori Nastaliq")
                rpr.append(OxmlElement("w:rtl"))
            else:
                run.font.name, run.font.size = "Calibri", docx.shared.Pt(12)
    bio = BytesIO()
    d.save(bio)
    bio.seek(0)
    return bio

def show_text(content, lang):
    with st.container(border=True):
        if lang.startswith("Urdu"):
            st.markdown(f'<div style="direction:rtl;text-align:right;font-size:18px;line-height:2">\n\n{content}\n\n</div>',
                        unsafe_allow_html=True)
        else:
            st.markdown(content)

def run_and_show(prompt, label, lang, image=None, spinner="AI kaam kar raha hai..."):
    with st.spinner(spinner):
        result = ask_ai(prompt, image)
    st.session_state.history.append({
        "time": datetime.now().strftime("%d-%m-%Y %H:%M"), "type": label,
        "query": prompt[-120:].replace("\n", " "), "result": result, "lang": lang})
    save_history()
    show_text(result, lang)
    st.download_button("📥 Word (.docx) mein download karein", make_docx(result, lang.startswith("Urdu")),
                       f"Legal_{datetime.now().strftime('%d%m%Y_%H%M')}.docx")
    st.caption("⚠️ AI ka draft/citation file karne se pehle khud check karein.")


