def compress_image(img_file):
    img = Image.open(img_file)
    if img.mode in ("RGBA", "P"):
        img = img.convert("RGB")
    if max(img.size) > 1280:
        img.thumbnail((1280, 1280), Image.Resampling.LANCZOS)
    out, q = BytesIO(), 85
    while True:
        out.seek(0); out.truncate(0)
        img.save(out, format="JPEG", quality=q)
        if out.tell() <= 500 * 1024 or q <= 20:
            break
        q -= 10
    return base64.b64encode(out.getvalue()).decode()

def template_context(file):
    if file is not None:
        try:
            d = docx.Document(file)
            text = "\n".join(p.text.strip() for p in d.paragraphs if p.text.strip())
            if text:
                return ("Adopt the phrasing, vocabulary and structure of this reference template:\n"
                        f"--- TEMPLATE START ---\n{text}\n--- TEMPLATE END ---")
        except Exception:
            pass
    return "Follow standard Pakistani court drafting style and terminology."

