    if not API_KEY:
        st.error("AI service configure nahi hai. Admin se rabta karein.")
        st.stop()
    content = prompt
    if image_file is not None:
        content = [{"type": "image", "source": {"type": "base64", "media_type": "image/jpeg",
                                                "data": compress_image(image_file)}},
                   {"type": "text", "text": prompt}]
    try:
        res = anthropic.Anthropic(api_key=API_KEY).messages.create(
            model="claude-sonnet-4-6", max_tokens=3500, system=SYSTEM_PROMPT,
            messages=[{"role": "user", "content": content}])
