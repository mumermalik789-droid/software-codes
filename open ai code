def validate_and_process_image(uploaded_img):
  if uploaded_img is None:
    return True, None
  size_in_kb = uploaded_img.size / 1024
  if size_in_kb > 500:
    st.info(
        f"ℹ️ Image size {size_in_kb:.1f}KB hai (500KB se ziada). System khud"
        " isko compress kar raha hai..."
    )
    return True, compress_image_to_under_500kb(uploaded_img)
  else:
    return True, uploaded_img


def compress_image_to_under_500kb(image_file):
  img = Image.open(image_file)
  if img.mode in ("RGBA", "P"):
    img = img.convert("RGB")
  max_dim = 1280
  if max(img.size) > max_dim:
    img.thumbnail((max_dim, max_dim), Image.Resampling.LANCZOS)
  output_io = BytesIO()
  quality = 85
  while True:
    output_io.seek(0)
    output_io.truncate(0)
    img.save(output_io, format="JPEG", quality=quality)
    if output_io.tell() <= 500 * 1024 or quality <= 20:
      break
    quality -= 10
  output_io.seek(0)
  return output_io


def encode_image(image_file):
  compressed_io = compress_image_to_under_500kb(image_file)
  return base64.b64encode(compressed_io.getvalue()).decode("utf-8")


def get_language_instruction(lang):
  if "Urdu (قانونی اردو)" in lang:
    return """IMPORTANT: Write the ENTIRE output strictly in High Court & District Court Standard Pakistani Legal Urdu (مستند و باضابطہ قانونی اردو). 
Follow authentic Pakistani advocate drafting terms (e.g. بعدالت جناب, سائل/درخواست گزار, مسئول عنہ, عرض ہے کہ, استدعا ہے کہ, حلف نامہ)."""
  elif "Roman Urdu" in lang:
    return (
        "IMPORTANT: Write the ENTIRE output strictly in Roman Urdu (Pakistani"
        " Urdu written in English script)."
    )
  else:
    return (
        "IMPORTANT: Write the ENTIRE output strictly in Standard Legal English"
        " as used in High Courts and Supreme Court of Pakistan."
    )


