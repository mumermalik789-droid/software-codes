SYSTEM_LEGAL_PROMPT = """
You are an expert Senior Advocate and Legal Drafter practicing in the High Courts and Supreme Court of Pakistan.
You excel at researching Pakistani laws (Constitution of Pakistan, CPC, PPC, CrPC, QSO, Revenue Laws), finding Supreme Court and High Court precedents/judgments, and drafting formal legal documents.
"""


def generate_ai_response(prompt_text, image_file=None):
  messages = [{"role": "system", "content": SYSTEM_LEGAL_PROMPT}]
  if image_file is not None:
    base64_image = encode_image(image_file)
    messages.append({
        "role": "user",
        "content": [
            {"type": "text", "text": prompt_text},
            {
                "type": "image_url",
                "image_url": {"url": f"data:image/jpeg;base64,{base64_image}"},
            },
        ],
    })
  else:
    messages.append({"role": "user", "content": prompt_text})

  res = client.chat.completions.create(
      model="gpt-4o", messages=messages, max_tokens=3500
  )
  return res.choices[0].message.content


def save_and_display_result(prompt_text, category_label, result_text, lang):
  st.session_state.history.append({
      "time": datetime.now().strftime("%d-%m-%Y %H:%M"),
      "type": category_label,
      "query": prompt_text[:120] + "...",
      "result": result_text,
      "lang": lang,
  })
  save_history_to_json()
  display_output(result_text, lang)
  st.download_button(
      "📥 Download as Word (.docx)",
      create_word_document(result_text, "Urdu" in lang),
      f"Legal_Draft_{datetime.now().strftime('%d%m%Y_%H%M')}.docx",
  )


