def extract_text_from_docx(file):
  if file is None:
    return ""
  doc = docx.Document(file)
  full_text = []
  for para in doc.paragraphs:
    if para.text.strip():
      full_text.append(para.text.strip())
  return "\n".join(full_text)


def create_word_document(text_content, is_urdu=False):
  doc = docx.Document()
  for line in text_content.split("\n"):
    line_str = line.strip()
    if not line_str:
      continue
    p = doc.add_paragraph()
    if is_urdu:
      p.alignment = WD_ALIGN_PARAGRAPH.RIGHT
      pPr = p._p.get_or_add_pPr()
      pPr.append(parse_xml(f'<w:bdr {nsdecls("w")}/>'))
      pPr.append(parse_xml(f'<w:bidi {nsdecls("w")}/>'))
    else:
      p.alignment = WD_ALIGN_PARAGRAPH.LEFT

    parts = re.split(r"(\*\*.*?\*\*)", line_str)
    for part in parts:
      if not part:
        continue
      run = p.add_run()
      if part.startswith("**") and part.endswith("**"):
        run.text = part[2:-2]
        run.bold = True
      else:
        run.text = part.replace("###", "").replace("##", "")

      if is_urdu:
        run.font.name = "Jameel Noori Nastaliq"
        run.font.size = docx.shared.Pt(14)
        rPr = run._r.get_or_add_rPr()
        rPr.append(
            parse_xml(
                f'<w:rFonts {nsdecls("w")} w:cs="Jameel Noori Nastaliq"'
                ' w:ascii="Calibri" w:hAnsi="Calibri"/>'
            )
        )
      else:
        run.font.name = "Calibri"
        run.font.size = docx.shared.Pt(12)

  bio = BytesIO()
  doc.save(bio)
  bio.seek(0)
  return bio


