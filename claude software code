      "result": result_text,
      "lang": lang,
  })
  save_history_to_json()
  display_output(result_text, lang)
  st.download_button(
      "📥 Download as Word (.docx)",
      create_word_document(result_text, "Urdu" in lang),
      f"Legal_Draft_{datetime.now().strftime('%d%m%Y_%H%M')}.docx",
  )


